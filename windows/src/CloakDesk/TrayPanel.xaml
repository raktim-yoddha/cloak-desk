<?xml version="1.0" encoding="utf-8"?>
<!-- The whole app, like a PC Manager or Quick Settings flyout: fixed size above the tray, header and status on top,
     settings scroll in the middle, footer at the bottom. Pinned, it stays open; otherwise clicking elsewhere closes it. -->
<Window
    x:Class="CloakDesk.TrayPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Cloak Desk panel">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.Resources>
            <Style x:Key="Caption" BasedOn="{StaticResource BodyStrongTextBlockStyle}" TargetType="TextBlock">
                <Setter Property="Margin" Value="4,20,0,8" />
            </Style>
            <Style x:Key="Hint" BasedOn="{StaticResource CaptionTextBlockStyle}" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Padding" Value="16,4" />
                <Setter Property="Background" Value="{ThemeResource GlassBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource GlassEdgeBrush}" />
                <Setter Property="BorderThickness" Value="0,1,0,0" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
            <!-- Setting row: text on the left, control on the right, never overlapping. -->
            <Style x:Key="Row" TargetType="Grid">
                <Setter Property="MinHeight" Value="56" />
                <Setter Property="Padding" Value="0,8" />
                <Setter Property="ColumnSpacing" Value="12" />
            </Style>
            <Style x:Key="Divider" TargetType="Border">
                <Setter Property="Height" Value="1" />
                <Setter Property="Margin" Value="-16,0" />
                <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            </Style>
        </Grid.Resources>

        <!-- Header and status: always visible -->
        <StackPanel Padding="20,16,20,12" Spacing="14">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image x:Name="Logo" Width="20" Height="20" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Cloak Desk" />
                <ToggleButton x:Name="PinButton" Grid.Column="2" Padding="8,6" Click="OnPinClicked"
                              AutomationProperties.Name="Keep open" ToolTipService.ToolTip="Keep open next to the tray">
                    <FontIcon x:Name="PinIcon" FontSize="14" Glyph="&#xE718;" />
                </ToggleButton>
            </Grid>

            <Border Padding="16" Style="{StaticResource Card}">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon x:Name="StateIcon" VerticalAlignment="Center" FontSize="24" Glyph="&#xE7B3;" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="StateText" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="18" />
                        <TextBlock x:Name="CloakHint" Style="{StaticResource Hint}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="CloakSwitch" Grid.Column="2" MinWidth="0" VerticalAlignment="Center" OffContent="" OnContent=""
                                  Toggled="OnCloakToggled" AutomationProperties.Name="Cloak" />
                </Grid>
            </Border>

            <TextBlock x:Name="ErrorText" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
        </StackPanel>

        <!-- Everything else scrolls -->
        <ScrollViewer x:Name="Scroller" Grid.Row="1" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="20,0,20,16">

                <!-- Preset -->
                <Grid>
                    <TextBlock Style="{StaticResource Caption}" Text="Preset" />
                    <StackPanel Margin="0,14,0,4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Orientation="Horizontal" Spacing="4">
                        <Button x:Name="NewPresetButton" Padding="8,6" Click="OnNewPreset" AutomationProperties.Name="New preset" ToolTipService.ToolTip="New preset">
                            <FontIcon FontSize="12" Glyph="&#xE710;" />
                        </Button>
                        <Button x:Name="DeletePresetButton" Padding="8,6" Click="OnDeletePreset" AutomationProperties.Name="Delete preset" ToolTipService.ToolTip="Delete this preset">
                            <FontIcon FontSize="12" Glyph="&#xE74D;" />
                        </Button>
                    </StackPanel>
                </Grid>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel x:Name="PresetList" Padding="0,8" />
                        <Border Style="{StaticResource Divider}" />
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="Name" />
                            <TextBox x:Name="NameBox" Grid.Column="1" VerticalAlignment="Center" TextChanged="OnNameChanged" AutomationProperties.Name="Preset name" />
                        </Grid>
                        <Border Style="{StaticResource Divider}" />
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Curtain color" />
                                <TextBlock x:Name="ColorText" Style="{StaticResource Hint}" />
                            </StackPanel>
                            <Button x:Name="ColorButton" Grid.Column="1" Padding="4" VerticalAlignment="Center" AutomationProperties.Name="Curtain color">
                                <Border x:Name="ColorSwatch" Width="44" Height="24" CornerRadius="4" />
                                <Button.Flyout>
                                    <Flyout>
                                        <ColorPicker x:Name="Picker" ColorChanged="OnColorChanged" IsAlphaEnabled="False"
                                                     IsMoreButtonVisible="False" IsColorChannelTextInputVisible="False" />
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>
                        <Border Style="{StaticResource Divider}" />
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Curtain image" />
                                <TextBlock x:Name="ImageText" Style="{StaticResource Hint}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button x:Name="RemoveImageButton" Grid.Column="1" Padding="8,6" VerticalAlignment="Center" Click="OnClearImage"
                                    AutomationProperties.Name="Remove image" ToolTipService.ToolTip="Remove image">
                                <FontIcon FontSize="12" Glyph="&#xE711;" />
                            </Button>
                            <Button Grid.Column="2" VerticalAlignment="Center" Click="OnPickImage" Content="Choose" AutomationProperties.Name="Choose image" />
                        </Grid>
                        <Border Style="{StaticResource Divider}" />
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Hide desktop" />
                                <TextBlock Style="{StaticResource Hint}" Text="Curtain over wallpaper and icons" />
                            </StackPanel>
                            <ToggleSwitch x:Name="DesktopSwitch" Grid.Column="1" MinWidth="0" VerticalAlignment="Center" OffContent="" OnContent=""
                                          Toggled="OnDesktopToggled" AutomationProperties.Name="Hide desktop" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Hidden apps -->
                <TextBlock Style="{StaticResource Caption}" Text="Hidden apps" />
                <Border Style="{StaticResource Card}">
                    <StackPanel Padding="0,12" Spacing="10">
                        <StackPanel x:Name="AppList" Spacing="4" />
                        <TextBlock x:Name="NoAppsText" Style="{StaticResource Hint}"
                                   Text="None yet. Press Ctrl+Alt+H in an app, or pick one below." />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="AppPicker" HorizontalAlignment="Stretch" IsEditable="True" PlaceholderText="App to hide"
                                      DropDownOpened="OnPickerOpened" AutomationProperties.Name="App to hide" />
                            <Button Grid.Column="1" Click="OnAddApp" Content="Hide" AutomationProperties.Name="Hide app" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- App settings -->
                <TextBlock Style="{StaticResource Caption}" Text="Settings" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="Start with Windows" />
                            <ToggleSwitch x:Name="StartupSwitch" Grid.Column="1" MinWidth="0" VerticalAlignment="Center" OffContent="" OnContent=""
                                          Toggled="OnStartupToggled" AutomationProperties.Name="Start with Windows" />
                        </Grid>
                        <Border Style="{StaticResource Divider}" />
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Keep this panel open" />
                                <TextBlock Style="{StaticResource Hint}" Text="Stays next to the tray, on top" />
                            </StackPanel>
                            <ToggleSwitch x:Name="PinSwitch" Grid.Column="1" MinWidth="0" VerticalAlignment="Center" OffContent="" OnContent=""
                                          Toggled="OnPinToggled" AutomationProperties.Name="Keep this panel open" />
                        </Grid>
                        <Border Style="{StaticResource Divider}" />
                        <StackPanel Padding="0,12" Spacing="2">
                            <TextBlock Text="Shortcuts" />
                            <TextBlock x:Name="HotkeyText" Style="{StaticResource Hint}"
                                       Text="Ctrl+Alt+C  cloak on or off&#x0a;Ctrl+Alt+H  hide the app in front" />
                        </StackPanel>
                        <Border Style="{StaticResource Divider}" />
                        <StackPanel Padding="0,12" Spacing="8">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Presets file" />
                                <TextBlock x:Name="FileText" Style="{StaticResource Hint}" IsTextSelectionEnabled="True" />
                            </StackPanel>
                            <Button Click="OnOpenFolder" Content="Open folder" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer: always visible -->
        <Grid Grid.Row="2" Padding="20,12" ColumnSpacing="12" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="VersionText" VerticalAlignment="Center" Style="{StaticResource Hint}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="1" Click="OnExit" Content="Exit" />
        </Grid>
    </Grid>
</Window>
