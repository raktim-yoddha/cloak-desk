<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="CloakDesk.App"
    RequestedTheme="Dark"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CloakDesk">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Dark only. In-app acrylic for panels, cards and bars: one step lighter than the gray window, light top edge. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <AcrylicBrush x:Key="GlassBrush" TintColor="#3A3A3A" TintOpacity="0.9" TintLuminosityOpacity="0.9" FallbackColor="#3A3A3A" />
                    <AcrylicBrush x:Key="GlassBarBrush" TintColor="#363636" TintOpacity="0.92" TintLuminosityOpacity="0.9" FallbackColor="#363636" />
                    <SolidColorBrush x:Key="GlassEdgeBrush" Color="#24FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="GlassBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="GlassBarBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="GlassEdgeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Card pattern on Mica: no NavigationView content layer, the cards are the layer. -->
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />

            <!-- Section header, as in Windows Settings. -->
            <Style x:Key="SectionHeaderStyle" BasedOn="{StaticResource BodyStrongTextBlockStyle}" TargetType="TextBlock">
                <Setter Property="Margin" Value="2,36,0,10" />
            </Style>

            <Style TargetType="local:SettingsRow">
                <Setter Property="Background" Value="{ThemeResource GlassBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource GlassEdgeBrush}" />
                <Setter Property="BorderThickness" Value="0,1,0,0" />
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
                <Setter Property="Padding" Value="20,16" />
                <Setter Property="MinHeight" Value="72" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="local:SettingsRow">
                            <Grid MinHeight="{TemplateBinding MinHeight}" Padding="{TemplateBinding Padding}"
                                  Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Margin="2,0,22,0" VerticalAlignment="Center" FontSize="20" Glyph="{TemplateBinding Glyph}" />
                                <StackPanel Grid.Column="1" Margin="0,0,20,0" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="{TemplateBinding Header}" TextWrapping="Wrap" />
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}"
                                               Text="{TemplateBinding Description}" TextWrapping="Wrap" />
                                </StackPanel>
                                <ContentPresenter Grid.Column="2" VerticalAlignment="Center" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
